{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "publikclip",
  "version": "0.1.0",
  "identifier": "com.publikhq.publikclip",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "node scripts/prepare-resources.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "publikclip",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: asset:; connect-src 'self' ipc: http://localhost:1430 ws://localhost:1430; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: blob: data:; media-src 'self' asset: blob:; font-src 'self' asset: data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.publikclip/jobs/*/clips/**",
          "$HOME/.publikclip/jobs/*/media*.mp4",
          "$HOME/.publikclip/jobs/*/overlays/**",
          "$HOME/.publikclip/ig_thumbs/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources"
    ]
  }
}
